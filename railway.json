{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'Using committed dist files'"
  },
  "deploy": {
    "startCommand": "node apps/api/dist/index.js",
    "preDeployCommand": "echo 'Skipping pre-deploy migration (run manually via Railway shell)'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
