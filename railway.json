{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'Using pre-compiled dist' && ls apps/api/dist/modules/academy-command/"
  },
  "deploy": {
    "startCommand": "node apps/api/dist/index.js",
    "preDeployCommand": "echo 'Migration skipped'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
