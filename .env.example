# Copy to .env at the repository root for local development.
DATABASE_URL=postgresql://localhost:5432/tuf_dev
TEST_DATABASE_URL=postgresql://localhost:5432/tuf_test
AUTH_TOKEN_SECRET=your-secret-here
INITIAL_OWNER_CREDENTIAL=0000
PORT=4000
NODE_ENV=development

# Optional: used by `pnpm db:seed:test-accounts`; required in production-like environments.
TEST_ACCOUNT_CREDENTIAL=9999
ALLOW_TEST_ACCOUNT_SEED=false

# Trello Mockup Integration — enables creative request → Trello card creation
# Get key + token from https://trello.com/power-ups/admin
# Get list ID by opening board URL + ".json" and finding the target list object
VITE_TRELLO_KEY=your_trello_api_key
VITE_TRELLO_TOKEN=your_trello_api_token
VITE_TRELLO_MOCKUP_LIST_ID=your_trello_list_id
# Optional: auto-assign designers and labels
# VITE_TRELLO_MOCKUP_MEMBER_IDS=comma,separated,member,ids
# VITE_TRELLO_MOCKUP_LABEL_IDS=comma,separated,label,ids
